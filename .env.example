# Copy this file to .env and fill in your real keys.
# .env is gitignored so secrets won't be committed.

# Gemini API key — free tier from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Groq API key — free tier from https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Cerebras API key — free tier from https://cloud.cerebras.ai/platform/api-keys
CEREBRAS_API_KEY=your_cerebras_key_here

# OpenRouter API key — free tier from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Postgres connection string. For local dev, use a Neon (https://neon.tech)
# dev branch — free tier, no install needed. Paste the connection string Neon
# gives you; backend normalizes it for asyncpg automatically. Required for the
# multi-user data layer (Stage 6a onward).
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
